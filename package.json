{
  "name": "tidy-renown",
  "version": "1.0.0",
  "private": true,
  "description": "Renown (DMG 2024) for Foundry VTT v14 + dnd5e 6.x, integrated with Tidy 5e Sheets.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "link": "node ./tools/link-foundry.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/tests/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run i18n:check && npm test",
    "i18n:check": "node ./tools/check-i18n.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0"
  }
}
