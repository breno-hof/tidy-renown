<div class="tr-dialog">
<div class="tr-dialog-body">
  <div class="tr-form-grid tr-rank-head">
    <div class="form-group">
      <label>{{localize "TIDY_RENOWN.Rank.MinScore"}}</label>
      <div class="form-fields">
        <input type="number" name="rank.minScore" value="{{rank.minScore}}" step="1" required />
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "TIDY_RENOWN.Rank.Name"}}</label>
      <div class="form-fields">
        <input type="text" name="rank.name" value="{{rank.name}}" placeholder="{{localize "TIDY_RENOWN.Rank.NamePlaceholder"}}" autofocus />
      </div>
    </div>
  </div>
  <div class="form-group stacked tr-rich-field">
    <label>{{localize "TIDY_RENOWN.Rank.Benefits"}}</label>
    <prose-mirror name="rank.description" value="{{rank.description}}"></prose-mirror>
    <p class="hint">{{localize "TIDY_RENOWN.Rank.DescriptionPlaceholder"}}</p>
  </div>
</div>
<footer class="form-footer tr-dialog-footer">
  <button type="button" data-action="cancel">{{localize "TIDY_RENOWN.Manager.Cancel"}}</button>
  <button type="submit" class="tr-primary">
    {{#if isEdit}}<i class="fa-solid fa-floppy-disk" inert></i> {{localize "TIDY_RENOWN.Manager.Save"}}{{else}}<i class="fa-solid fa-plus" inert></i> {{localize "TIDY_RENOWN.Manager.AddRank"}}{{/if}}
  </button>
</footer>
</div>
