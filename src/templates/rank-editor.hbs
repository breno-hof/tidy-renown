<div class="tr-rank-editor-body">
  <p class="hint">{{localize "TIDY_RENOWN.Manager.RankEditorHint"}}</p>
  <div class="form-group">
    <label>{{localize "TIDY_RENOWN.Rank.MinScore"}}</label>
    <div class="form-fields">
      <input type="number" name="rank.minScore" value="{{minScore}}" step="1" required />
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "TIDY_RENOWN.Rank.NamePlaceholder"}}</label>
    <div class="form-fields">
      <input type="text" name="rank.name" placeholder="{{localize "TIDY_RENOWN.Rank.NamePlaceholder"}}" />
    </div>
  </div>
  <div class="form-group stacked tr-rich-field">
    <label>{{localize "TIDY_RENOWN.Rank.DescriptionPlaceholder"}}</label>
    <prose-mirror name="rank.description" value="" compact="true" toggled="true"></prose-mirror>
  </div>
  <footer class="form-footer">
    <button type="button" data-action="cancel">{{localize "TIDY_RENOWN.Manager.Cancel"}}</button>
    <button type="submit"><i class="fa-solid fa-plus" inert></i> {{localize "TIDY_RENOWN.Manager.AddRank"}}</button>
  </footer>
</div>
