<div class="tr-dialog">
<div class="tr-dialog-body">
  <div class="form-group stacked tr-rich-field">
    <prose-mirror name="notes" value="{{notes}}"></prose-mirror>
    <p class="hint">{{localize "TIDY_RENOWN.Notes.Hint"}}</p>
  </div>
</div>
<footer class="form-footer tr-dialog-footer">
  <button type="button" data-action="cancel">{{localize "TIDY_RENOWN.Manager.Cancel"}}</button>
  <button type="submit" class="tr-primary"><i class="fa-solid fa-floppy-disk" inert></i> {{localize "TIDY_RENOWN.Manager.Save"}}</button>
</footer>
</div>
